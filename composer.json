{
    "name": "niels023/pc-bouwplanner",
    "description": "Website om zelf een PC samen te stellen en te controleren of de onderdelen bij elkaar passen.",
    "type": "project",
    "require": {
        "php": "^8.2",
        "ext-pdo": "*",
        "vlucas/phpdotenv": "^5.8"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "phpcs",
        "fix": "phpcbf",
        "seed": "php database/seed.php",
        "start": [
            "Composer\\Config::disableProcessTimeout",
            "php -S localhost:8000 -t public"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "squizlabs/php_codesniffer": "^4.0"
    }
}
